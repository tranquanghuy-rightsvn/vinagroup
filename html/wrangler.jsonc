// Cloudflare Workers Static Assets — deploy with: npx wrangler deploy
// Content is synced from thien/master:v2 (see scripts/sync-from-thien.sh)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vina-group-com-vn",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./",
    // /gioi-thieu -> /gioi-thieu/ (clean URLs, like vercel.json cleanUrls)
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Attach the real domain once the zone vina-group.com.vn is on this Cloudflare account:
  // "routes": [
  //   { "pattern": "vina-group.com.vn", "custom_domain": true },
  //   { "pattern": "www.vina-group.com.vn", "custom_domain": true }
  // ],
  "observability": { "enabled": true }
}
